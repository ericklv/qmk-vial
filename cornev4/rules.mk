# VIAL support — enables configuration from vial.rocks
VIA_ENABLE          = yes
VIAL_ENABLE         = yes
VIALRGB_ENABLE      = yes

# Anti-EMI: symmetric deferred global debounce algorithm
# Most effective software filter against EMI-induced ghost presses
DEBOUNCE_TYPE = sym_defer_g

# Encoder map support
ENCODER_MAP_ENABLE = yes
